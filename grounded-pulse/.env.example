# Database Configuration (TiDB Serverless / MySQL)
# For TiDB Serverless: https://tidbcloud.com — free 25GB, no credit card
#
# After creating a cluster, go to:
#   Cluster → Connect → "Connect with" → General
# Copy the connection details here:

DB_HOST=your-cluster.tidbcloud.com
DB_PORT=4000
DB_USER=your-username.root
DB_PASSWORD=your-password
DB_NAME=grounded_pulse
DB_SSL=true

# For local MySQL development, use:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=grounded_pulse
# DB_SSL=false
